# Server Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Supabase Configuration
SUPABASE_URL=your_supabase_url
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_KEY=your_supabase_service_key

# Redis Configuration (for BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# AI Configuration
# Choose your AI provider and model
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini

# AI API Keys (at least one required)
# Primary providers (recommended)
OPENAI_API_KEY=your_openai_api_key
GROQ_API_KEY=your_groq_api_key
XAI_API_KEY=your_xai_api_key
GOOGLE_API_KEY=your_google_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key
MISTRAL_API_KEY=your_mistral_api_key

# Additional providers
DEEPSEEK_API_KEY=your_deepseek_api_key
TOGETHERAI_API_KEY=your_togetherai_api_key
COHERE_API_KEY=your_cohere_api_key
FIREWORKS_API_KEY=your_fireworks_api_key
DEEPINFRA_API_KEY=your_deepinfra_api_key
CEREBRAS_API_KEY=your_cerebras_api_key

# Azure OpenAI
AZURE_OPENAI_API_KEY=your_azure_api_key
AZURE_RESOURCE_NAME=your_resource_name
AZURE_DEPLOYMENT_NAME=your_deployment_name

# Google Vertex AI
VERTEX_PROJECT_ID=your_project_id
VERTEX_LOCATION=us-central1

# AWS Bedrock
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1

# Calendar API Keys
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
MICROSOFT_CLIENT_ID=your_microsoft_client_id
MICROSOFT_CLIENT_SECRET=your_microsoft_client_secret

# WhatsApp Configuration
WHATSAPP_SESSION_PATH=./whatsapp-session
# Message Filter Mode:
# 1 = Only accept messages from others (ignore your own sent messages)
# 2 = Only accept messages when chatting with yourself (Your Number <-> Your Number)
# 3 = Accept all messages (both from others and self-chat)
WHATSAPP_MESSAGE_FILTER_MODE=3

# Whitelisted Phone Numbers (for modes 1 and 3)
# Comma-separated list of phone numbers that are allowed to trigger AI responses
# Format: country code + number (e.g., 919876543210,918765432109)
# Leave empty to allow all numbers
WHATSAPP_ALLOWED_NUMBERS=
